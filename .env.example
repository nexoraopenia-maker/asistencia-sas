# =============================================================================
# Scire 360 Chronos - Variables de entorno
# Copia este archivo a `.env` (raiz) y `.env.local` (apps) y rellena los valores.
# NUNCA commitees el archivo .env real.
# =============================================================================

NODE_ENV=development
APP_NAME="Scire 360 Chronos"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL)
# En local usa el docker-compose incluido. En produccion usa la URL de Easypanel.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://scire:scire_dev_password@localhost:5432/scire360?schema=public"
# URL directa sin pooler (necesaria para migraciones si usas PgBouncer/Supabase)
DIRECT_URL="postgresql://scire:scire_dev_password@localhost:5432/scire360?schema=public"
#
# --- Neon (serverless) ---
# DATABASE_URL = host CON "-pooler" (PgBouncer): API y seed en ejecucion.
# DIRECT_URL   = el MISMO host SIN "-pooler": `prisma migrate` necesita una
#                sesion con estado y no funciona a traves del pooler.
# connect_timeout=15 da margen al arranque en frio cuando el compute de Neon
# esta suspendido (el valor por defecto de Prisma, 5 s, puede no bastar).
# Con Prisma >= 5.10 no hace falta `pgbouncer=true`.
# DATABASE_URL="postgresql://<usuario>:<password>@ep-xxxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15"
# DIRECT_URL="postgresql://<usuario>:<password>@ep-xxxx.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15"

# Credenciales usadas por docker-compose para levantar Postgres local
POSTGRES_USER=scire
POSTGRES_PASSWORD=scire_dev_password
POSTGRES_DB=scire360

# -----------------------------------------------------------------------------
# REDIS (cache, sesiones, rate limiting, colas)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# RATE LIMITING
# Si Redis no esta disponible, los limitadores caen a un respaldo en memoria
# por proceso: degradado, pero nunca abierto de par en par.
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Intentos de autenticacion por minuto (por IP y por credencial, a la vez)
RATE_LIMIT_AUTH_PER_MINUTE=5
# Marcaciones por minuto y por usuario
RATE_LIMIT_PUNCH_PER_MINUTE=10
# Lotes de marcaciones por minuto que puede enviar cada reloj biometrico.
RATE_LIMIT_BIOMETRIC_PER_MINUTE=30
RATE_LIMIT_GLOBAL_PER_MINUTE=300

# -----------------------------------------------------------------------------
# AUTENTICACION / JWT
# Genera secretos con: openssl rand -base64 48
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET="<genera-un-secreto-de-48-bytes>"
JWT_REFRESH_SECRET="<genera-otro-secreto-distinto-de-48-bytes>"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# Sal para hashing de contrasenas (bcrypt rounds)
BCRYPT_ROUNDS=12

# Contrasena de los usuarios del seed demo (pnpm db:seed).
# Cambiala siempre antes de sembrar un entorno accesible desde internet.
SEED_PASSWORD="Chronos2026Demo!"

# Operador de la plataforma (SUPER_ADMIN) que gestiona empresas en /admin.
# Opcional: si no se definen, el seed no crea ninguno. Usa una contrasena
# fuerte (10+ caracteres, mayuscula, minuscula y numero).
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_PASSWORD=""
PLATFORM_ADMIN_NAME="Administrador de plataforma"

# -----------------------------------------------------------------------------
# ALMACENAMIENTO DE SELFIES (S3 compatible: AWS S3 o Cloudflare R2)
# Las imagenes NUNCA son publicas: solo se sirven via presigned URL.
# -----------------------------------------------------------------------------
S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="scire360-punches"
S3_ACCESS_KEY_ID="<tu-access-key>"
S3_SECRET_ACCESS_KEY="<tu-secret-key>"
S3_FORCE_PATH_STYLE=true
# Segundos de validez de las presigned URLs.
# S3_PRESIGN_GET_TTL esta topado a 900 (15 min) por politica: una URL firmada
# de una selfie es un dato biometrico circulando por la red.
S3_PRESIGN_PUT_TTL=120
S3_PRESIGN_GET_TTL=300
# Opcional: dominio propio o CDN por el que servir las selfies, para no exponer
# el host del bucket. El CDN debe reenviar conservando la cabecera Host o la
# firma SigV4 no valida.
# S3_PUBLIC_BASE_URL="https://media.tu-dominio.com"

# -----------------------------------------------------------------------------
# FACE MATCH (AWS Rekognition) - solo tier ENTERPRISE
# -----------------------------------------------------------------------------
# Interruptor de plataforma. Cada empresa tiene ademas el suyo, y el plan
# ENTERPRISE es requisito: sin el, el flag de la empresa no hace nada.
FACE_MATCH_ENABLED=false
AWS_REKOGNITION_REGION="us-east-1"
AWS_ACCESS_KEY_ID="<tu-access-key>"
AWS_SECRET_ACCESS_KEY="<tu-secret-key>"
FACE_MATCH_MIN_SCORE=85
# Cada cuantos segundos el trabajador procesa las verificaciones pendientes
FACE_MATCH_INTERVAL_SECONDS=20

# -----------------------------------------------------------------------------
# GEOCERCAS / ANTIFRAUDE
# -----------------------------------------------------------------------------
# Metros extra de tolerancia sumados al radio de la sucursal
GEOFENCE_ACCURACY_BUFFER_M=25
# true = rechaza la marcacion con GPS falso | false = la registra como SUSPICIOUS
REJECT_MOCK_LOCATION=false
# Desfase maximo tolerado entre el reloj del movil y el del servidor en una
# marcacion ONLINE. Por encima, la marcacion se guarda como sospechosa.
MAX_ONLINE_CLOCK_SKEW_SECONDS=300
# Antiguedad maxima de una marcacion encolada offline. Mas vieja, la regulariza RRHH.
MAX_OFFLINE_AGE_HOURS=72

# Relojes biometricos
# Lecturas del mismo empleado mas juntas que esto (segundos) cuentan como una.
BIOMETRIC_DEBOUNCE_SECONDS=60
# Antigüedad maxima (dias) de una marcacion importada desde el log del reloj.
BIOMETRIC_MAX_AGE_DAYS=31

# -----------------------------------------------------------------------------
# BILLING
# -----------------------------------------------------------------------------
# Pasarela por defecto: mercadopago | stripe
BILLING_PROVIDER=mercadopago
# Moneda de cobro (ISO 4217). PEN, ARS, MXN, BRL, USD...
BILLING_CURRENCY=USD
# Dias del periodo de prueba al registrar una empresa nueva
TRIAL_DAYS=14
# Cada cuantos minutos corre el cron que suspende trials y gracias vencidas
BILLING_EXPIRATION_INTERVAL_MINUTES=60

# --- MercadoPago (prioritario en LATAM) ---
# El access token empieza por APP_USR- (produccion) o TEST- (sandbox).
# La API rechaza cualquier otro formato: si dejas el marcador de ejemplo,
# el panel mostrara la facturacion como NO configurada, que es lo correcto.
MERCADOPAGO_ACCESS_TOKEN="APP_USR-<tu-access-token>"
MERCADOPAGO_PUBLIC_KEY="<tu-public-key>"
# Se define al dar de alta el webhook en el panel de MercadoPago.
# Sin el no se pueden verificar las notificaciones y el checkout queda cerrado.
MERCADOPAGO_WEBHOOK_SECRET="<tu-webhook-secret>"

# --- Stripe (alternativa) ---
# La clave secreta empieza por sk_test_ o sk_live_.
STRIPE_SECRET_KEY="sk_test_<tu-stripe-secret-key>"
# El secreto del endpoint empieza por whsec_
STRIPE_WEBHOOK_SECRET="whsec_<tu-stripe-webhook-secret>"

# -----------------------------------------------------------------------------
# NOTIFICACIONES / AUTOMATIZACIONES
# -----------------------------------------------------------------------------
N8N_WEBHOOK_URL="https://n8n.tu-dominio.com/webhook/scire360"
N8N_WEBHOOK_SECRET="<secreto-hmac-compartido>"
# Cada cuantos segundos el despachador vacia el outbox de webhooks
WEBHOOK_DISPATCH_INTERVAL_SECONDS=30
# Reintentos con backoff exponencial antes de dar una entrega por perdida
WEBHOOK_MAX_ATTEMPTS=6
EVOLUTION_API_URL="https://evolution.tu-dominio.com"
EVOLUTION_API_KEY="<tu-api-key>"
EVOLUTION_INSTANCE="scire360"

# -----------------------------------------------------------------------------
# EMAIL (invitaciones de onboarding)
# -----------------------------------------------------------------------------
SMTP_HOST="smtp.tu-proveedor.com"
SMTP_PORT=587
SMTP_USER="<usuario>"
SMTP_PASSWORD="<password>"
SMTP_FROM="Scire 360 Chronos <no-reply@tu-dominio.com>"

# -----------------------------------------------------------------------------
# RETENCION DE DATOS BIOMETRICOS
# -----------------------------------------------------------------------------
# El plazo real es por empresa (Company.dataRetentionMonths, 12 por defecto).
# Aqui solo se configura cada cuantas horas corre el barrido de purga.
RETENTION_INTERVAL_HOURS=24

# -----------------------------------------------------------------------------
# FRONTEND (apps/web) - variables publicas expuestas al navegador
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME="Scire 360 Chronos"
# Opcional: enlace https del APK que se ofrece en /descargar.
MOBILE_APK_URL=""

# -----------------------------------------------------------------------------
# MOBILE (apps/mobile) - Expo solo expone variables con prefijo EXPO_PUBLIC_
# -----------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:4000
